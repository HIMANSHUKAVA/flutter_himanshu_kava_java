package main.controller;

import javax.servlet.http.HttpServletRequest;
import javax.servlet.http.HttpServletResponse;
import javax.servlet.http.HttpSession;

import org.hibernate.classic.Session;
import org.omg.CORBA.PUBLIC_MEMBER;
import org.springframework.context.ApplicationContext;
import org.springframework.context.support.ClassPathXmlApplicationContext;
import org.springframework.web.bind.annotation.RequestMapping;

import main.bo.Bo;
import main.model.Person;

@org.springframework.stereotype.Controller
public class Controller
{

	@RequestMapping("/")
	public String homecontroller()
	{
		return "index";
	}
	
	@RequestMapping("/addEmployee")
	public String insertdeta(HttpServletRequest request , HttpServletResponse response)
	{
		
		String name =  request.getParameter("name");
		String email =  request.getParameter("email");
		String adress = request.getParameter("address");
		String phone =  request.getParameter("phone");
		
		
		ApplicationContext applicationContext = new ClassPathXmlApplicationContext("beans.xml");
		Bo bo =  applicationContext.getBean("s2" , Bo.class);
		
		Person person = new Person();
		person.setName(name);
		person.setAddress(adress);
		person.setEmail(email);
		person.setPhone(phone);
		
		
		HttpSession session =  request.getSession("user" , person);
		
		bo.insertdeta(person);
		
		return "index";
		
	}
	
	@RequestMapping("/deleat")
    public String  deleatdeta(Person p , HttpServletRequest req , HttpServletResponse resp)
    {
		int id = Integer.parseInt(req.getParameter("id"));
		
		
		p.setId(id);
		
		ApplicationContext ap = new ClassPathXmlApplicationContext("beans.xml");
		Bo bo  = ap.getBean("s2" , Bo.class);
		
		
		bo.deleatdeta(p);
		
		return "index";
    }
	
	
	
	
	
}
