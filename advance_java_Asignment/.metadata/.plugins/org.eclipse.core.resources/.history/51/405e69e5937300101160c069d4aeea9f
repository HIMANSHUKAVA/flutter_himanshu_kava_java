<%@ page import="javax.servlet.http.*,javax.servlet.*" %>
<%@ page session="true" %>
<%
    String senderEmail = (String) session.getAttribute("email"); // Logged-in user
%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Send Message</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light">
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-lg">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Send Message</h5>
                </div>
                <div class="card-body">
                    <form action="SendMessageServlet" method="post">

                        <!-- Sender email (hidden) -->
                        <input type="hidden" name="sender" value="<%= senderEmail %>" />

                        <!-- Receiver email -->
                        <div class="mb-3">
                            <label for="receiver" class="form-label">Receiver Email</label>
                            <input type="email" class="form-control" id="receiver" name="receiver" required placeholder="Enter receiver's email">
                        </div>

                        <!-- Message -->
                        <div class="mb-3">
                            <label for="message" class="form-label">Message</label>
                            <textarea class="form-control" id="message" name="message" rows="4" required placeholder="Write your message here..."></textarea>
                        </div>

                        <!-- Submit -->
                        <div class="d-grid">
                            <button type="submit" class="btn btn-success">Send Message</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
