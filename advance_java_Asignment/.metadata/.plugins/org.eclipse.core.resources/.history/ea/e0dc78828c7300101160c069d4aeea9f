<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>User Registration</title>
    <!-- Bootstrap 5 CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<script type="text/javascript" >

  var request =  new XMLHttpRequest();

     function serchinfo() 
    {
	
    	 
    	 var name =  document.vinform.email.value;
    	 var url = "ajexserch.jsp?name="+name;
    	 
    	 try
    	 {
    		 request.onreadystatechange=function()
    		 {
                if(request.readyState==4)
                	{
                       var val = request.responsetext();
                       document.getElementById('tops').innerHTML=val
                       
                	}
    		 }
    		 
    		 request.open("GET",url,true);
    		 request.send();
    	 }
    	 catch(e)
    	 {

    		 alert("unable to connect");
    	 }
    	 
    	 
	}
</script>
<body class="bg-light">

    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-6">

                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="text-center">User Registration</h4>
                    </div>
                    <div class="card-body">
                        <form action="ajexserch.jsp" method="post" id="registrationForm" name="vinform">
                            
                            <!-- Email Field -->
                            <div class="mb-3">
                                <label for="email" class="form-label">Email address</label>
                                <input type="email" class="form-control" id="email" name="email" required placeholder="Enter email">
                                <div id="emailFeedback" class="form-text text-danger"></div>
                            </div>

                            <!-- Password Field -->
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" class="form-control" id="password" name="password" required minlength="6" placeholder="Enter password">
                            </div>

                            <!-- Submit Button -->
                            <div class="d-grid">
                                <button type="submit" class="btn btn-success">Register</button>
                            </div>

                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<span id="tops"></span>  

</body>
</html>
